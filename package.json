{
  "name": "shopfeel-api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Shopfeel para painel web administrativo e aplicativo mobile",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "knex --knexfile knexfile.js migrate:latest",
    "db:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "db:seed": "knex --knexfile knexfile.js seed:run",
    "test": "node --test",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.0.2",
    "zod": "^4.1.12",
    "nodemailer": "^7.0.6"
  },
  "devDependencies": {
    "eslint": "^9.37.0",
    "supertest": "^7.1.4"
  }
}
